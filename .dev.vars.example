# Copy to .dev.vars for local `wrangler dev`. Never commit .dev.vars.

# Paste your OpenRouter key. Without it the dashboard, forecasts and
# explainability all still work; only the chat needs it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# The Basic-auth gate. The Worker fails closed, so it is unreachable until
# both are set. Vite reads the same two values and attaches them to proxied
# API calls, so the dev server works without a browser prompt.
# Values are shared out of band — never commit them.
# `wrangler dev` reads this file once at startup: restart it after editing,
# or the Worker keeps comparing against the previous values.
AUTH_USER=
AUTH_PASSWORD=
